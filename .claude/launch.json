{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "digitalbrain",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "scripts/serve.py",
        "--port",
        "8055",
        "--instance",
        "preview"
      ],
      "port": 8055
    },
    {
      "name": "digitalbrain-dev",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["scripts/serve.py", "--port", "8057", "--instance", "preview-dev"],
      "env": {"DIGITAL_BRAIN_CONFIG": "config/local.runtime.toml"},
      "port": 8057
    },
    {
      "name": "digitalbrain-pages",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["manage.py", "runserver", "8056", "--noreload"],
      "port": 8056
    }
  ]
}
