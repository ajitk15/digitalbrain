{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "digitalbrain",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "scripts/serve.py",
        "--port",
        "8055",
        "--instance",
        "preview"
      ],
      "port": 8055
    },
    {
      "name": "diagrams",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8781",
        "--directory",
        "docs/diagrams"
      ],
      "port": 8781
    }
  ]
}
