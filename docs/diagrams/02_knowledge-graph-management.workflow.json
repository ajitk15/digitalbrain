{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Knowledge graph management",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "From arrival to answering"
    },
    {
      "id": "runs",
      "label": "Requested runs"
    },
    {
      "id": "stale",
      "label": "After publishing"
    }
  ],
  "phases": [
    {
      "id": "ph_free",
      "label": "Structural, no model",
      "fromCol": 0,
      "toCol": 3
    },
    {
      "id": "ph_human",
      "label": "Publish",
      "fromCol": 4,
      "toCol": 4,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "intake",
    "source",
    "working",
    "draft",
    "published"
  ],
  "nodes": [
    {
      "id": "intake",
      "lane": "main",
      "col": 0,
      "width": 132,
      "type": "external",
      "label": "Intake",
      "sublabel": "downloaded, converted"
    },
    {
      "id": "source",
      "lane": "main",
      "col": 1,
      "width": 132,
      "type": "database",
      "label": "Active source",
      "sublabel": "never edited"
    },
    {
      "id": "working",
      "lane": "main",
      "col": 2,
      "width": 132,
      "type": "backend",
      "label": "Working graph",
      "sublabel": "after intake settles"
    },
    {
      "id": "draft",
      "lane": "main",
      "col": 3,
      "width": 132,
      "type": "database",
      "label": "Draft revision",
      "sublabel": "answers nothing"
    },
    {
      "id": "published",
      "lane": "main",
      "col": 4,
      "width": 132,
      "type": "database",
      "label": "Published revision",
      "sublabel": "the one that answers"
    },
    {
      "id": "enrich",
      "lane": "runs",
      "col": 2,
      "width": 132,
      "type": "messagebus",
      "label": "Requested AI run",
      "sublabel": "paid graph enrichment"
    },
    {
      "id": "failed",
      "lane": "runs",
      "col": 3,
      "width": 132,
      "type": "messagebus",
      "label": "Generation failed",
      "sublabel": "never retried on its own"
    },
    {
      "id": "drifted",
      "lane": "stale",
      "col": 4,
      "width": 132,
      "type": "external",
      "label": "Answering from older",
      "sublabel": "drift shown in UI"
    },
    {
      "id": "readers",
      "lane": "stale",
      "col": 3,
      "width": 132,
      "type": "frontend",
      "label": "Graph consumers",
      "sublabel": "published evidence"
    }
  ],
  "edges": [
    {
      "from": "intake",
      "to": "source",
      "label": "digest decides",
      "variant": "emphasis"
    },
    {
      "from": "source",
      "to": "working",
      "label": "fingerprint moves",
      "variant": "emphasis"
    },
    {
      "from": "working",
      "to": "draft",
      "label": "saves a draft",
      "variant": "emphasis"
    },
    {
      "from": "draft",
      "to": "published",
      "label": "a human publishes",
      "variant": "dashed"
    },
    {
      "from": "working",
      "to": "enrich",
      "label": "on request"
    },
    {
      "from": "enrich",
      "to": "draft",
      "label": "one paid run"
    },
    {
      "from": "enrich",
      "to": "failed",
      "label": "provider error",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "published",
      "to": "drifted",
      "label": "sources move on"
    },
    {
      "from": "failed",
      "to": "enrich",
      "label": "a human retries",
      "variant": "dashed"
    },
    {
      "from": "published",
      "to": "readers",
      "label": "verified evidence",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Currency is automatic; publishing is not",
      "items": [
        "Source drift triggers a structural rebuild after pending intake finishes",
        "Each completed rebuild saves a draft; failed paid calls need an explicit retry",
        "Publishing checks recorded sources; newly added sources do not block it"
      ]
    },
    {
      "dot": "cyan",
      "title": "Who reads it, and how",
      "items": [
        "Graph answer and Code Factory require a published revision",
        "Graph-search REST/MCP are model-free; chat and triage REST may call AI",
        "Sources/AI chat read active sources without graph publication",
        "Graph-search returns 409 without a published version; drift is shown in Knowledge"
      ]
    }
  ]
}
