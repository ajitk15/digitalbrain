  "edges": [
    {
      "from": "intake",
      "to": "source",
      "label": "digest decides",
      "variant": "emphasis"
    },
    {
      "from": "source",
      "to": "working",
      "label": "fingerprint moves",
      "variant": "emphasis"
    },
    {
