  "cards": [
    {
      "dot": "cyan",
      "title": "An incident record is just a source",
      "items": [
        "Connector pulls are bounded; manual and scheduled imports are supported",
        "Each changed record creates a new source revision with a SHA-256 digest",
        "Sources/AI chat can read active records before graph publication"
      ]
    },
    {
      "dot": "amber",
      "title": "The platform never touches the service",
      "items": [
        "The incident workflow does not execute runbooks or update external tickets",
        "Graph-search REST and MCP are model-free; chat/triage APIs can use AI",
        "ServiceOps has its own triage flow; code changes use Code Factory gates"
      ]
    }
  ]
