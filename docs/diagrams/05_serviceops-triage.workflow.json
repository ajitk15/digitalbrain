  "cards": [
    {
      "dot": "cyan",
      "title": "Evidence first, model second",
      "items": [
        "Profile → evidence → model/cache → verify → score → save",
        "Handled AI errors yield evidence only; access, stale intake or unexpected errors fail",
        "No published graph removes document passages, not incident triage"
      ]
    },
    {
      "dot": "amber",
      "title": "One provisional band per run",
      "items": [
        "Up to three hypotheses keep model order; no individual confidence scores",
        "No supported hypothesis or score below 0.35: evidence only; below 0.55: Low; else Medium",
        "Confirmed causes count only when retrieved and cited on a later run"
      ]
    }
  ]
