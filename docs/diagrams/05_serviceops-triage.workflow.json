          "raised",
          "fingerprint",
          "similar",
          "context"
        ],
        "note": "A live operations-graph walk joins incidents, changes, confirmed causes and published document passages into a model-free pack."
      },
      {
        "id": "reason",
        "label": "Reasoning, verified and scored",
        "focus": [
          "hypothesize",
          "verify",
          "score"
        ],
        "note": "Exact quotes and a next-step keyword filter gate hypotheses. One run-level score sets the band; it does not prove a cause."
      },
      {
        "id": "learn",
        "label": "Deciding and learning",
        "focus": [
          "brief",
          "decide",
          "outcome",
          "resolved"
        ],
        "note": "Only a selected cited cause can feed future evidence. Verdicts alone do not change scores; their author may retract them."
      }
    ]
