  "cards": [
    {
      "dot": "cyan",
      "title": "Evidence first, model second",
      "items": [
        "Past incidents, runbooks and changes are found without a model charge",
        "The model only ranks and explains evidence that was already retrieved",
        "Citations have an active source and exact quote; responders judge whether each quote supports its claim"
      ]
    },
    {
      "dot": "amber",
      "title": "Confidence is computed, not claimed",
      "items": [
        "Scored from similarity, agreement, change correlation and verified coverage",
        "Below the floor it abstains and shows the evidence instead of guessing",
        "Confirmed outcomes calibrate the bands; nothing is executed on the service"
