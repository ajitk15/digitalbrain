        "id": "reason",
        "label": "Reasoning, verified and scored",
        "focus": [
          "hypothesize",
          "verify",
          "score"
        ],
        "note": "The model proposes; citations are re-checked; confidence is computed from evidence, never taken from the model."
      },
      {
        "id": "learn",
        "label": "Deciding and learning",
        "focus": [
          "brief",
          "decide",
          "outcome",
          "resolved"
        ],
