<mxfile host="app.diagrams.net" type="device"><diagram id="09-chat-application" name="Chat application process"><mxGraphModel adaptiveColors="auto" background="#ffffff" pageWidth="1120" pageHeight="1040"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#24344b;" value="09 / Chat application process" vertex="1"><mxGeometry height="42" width="1050" x="35" y="22" as="geometry" /></mxCell><mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#24344b;" value="Persist first, retrieve scoped evidence, stream an answer and retain a verified transcript." vertex="1"><mxGeometry height="38" width="1050" x="35" y="70" as="geometry" /></mxCell><mxCell id="browser" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Browser conversation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Create / resume own chat&lt;br&gt;Select mode when created&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="45" y="140" as="geometry" /></mxCell><mxCell id="access" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Validate submission&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Session + CSRF + app grants&lt;br&gt;Mode available; deduplicate&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="140" as="geometry" /></mxCell><mxCell id="save" parent="1" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Persist before provider&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&