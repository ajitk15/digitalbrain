<mxfile host="app.diagrams.net" type="device"><diagram id="07-code-factory" name="Code Factory process"><mxGraphModel adaptiveColors="auto" background="#ffffff" pageWidth="1120" pageHeight="1040"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#24344b;" value="07 / Code Factory process" vertex="1"><mxGeometry height="42" width="1050" x="35" y="22" as="geometry" /></mxCell><mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#24344b;" value="Evidence-backed planning and controlled implementation with separate delivery authorization." vertex="1"><mxGeometry height="38" width="1050" x="35" y="70" as="geometry" /></mxCell><mxCell id="ticket" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Ticket / manual request&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Authorize feature and user&lt;br&gt;Copy ticket + digest&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="45" y="140" as="geometry" /></mxCell><mxCell id="pin" parent="1" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Pin evidence + code&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Published graph version&lt;br&gt;Code snapshot + repository&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="140" as="geometry" /></mxCell><mxCell id="triage" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;1. Triage&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Classify request&lt;br&gt;Extract stated requirements&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="140" as="geometry" /></mxCell><mxCell id="analysis" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;2. Analysis&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Stated / functional / NFR gaps&lt;br&gt;Cite verified evidence&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="855" y="140" as="geometry" /></mxCell><mxCell id="design" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;3. Design&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Targets + change summaries&lt;br&gt;Create ChangePlan&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="855" y="300" as="geometry" /></mxCell><mxCell id="approval" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Plan approval&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Authorized approver reviews&lt;br&gt;Reject or approve digest&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="300" as="geometry" /></mxCell><mxCell id="order" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;4. Work order&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Approved scope&lt;br&gt;Implementation instructions&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="300" as="geometry" /></mxCell><mxCell id="implement" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;5. Implementation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Prepare candidate contents&lt;br&gt;No delivery credential needed&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="45" y="300" as="geometry" /></mxCell><mxCell id="tests" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;6. Test author&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Produce relevant tests&lt;br&gt;Against approved changes&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="45" y="470" as="geometry" /></mxCell><mxCell id="review" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;7. Change review&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Review scope, safety&lt;br&gt;and evidence&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="470" as="geometry" /></mxCell><mxCell id="verify" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;8. Verification&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Check prepared change&lt;br&gt;Record phase result&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="470" as="geometry" /></mxCell><mxCell id="delivergate" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Delivery gate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Confirm repo + base branch&lt;br&gt;Separate write credential&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="855" y="470" as="geometry" /></mxCell><mxCell id="delivery" parent="1" style="rounded=1;arcSize=12;whiteSpace=wr