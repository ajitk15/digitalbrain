geometry" /></mxCell><mxCell id="legend" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#24344b;" value="Blue: processing   Green: stored data / result   Yellow: gate   Purple: security   Orange: external   Red: failure&#10;Solid arrows: flow / dependency   Dashed arrows: asynchronous work" vertex="1"><mxGeometry height="40" width="1050" x="35" y="954" as="geometry" /></mxCell><mxCell id="meta-evidence" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#24344b;" value="Evidence: platform_core/models/factory.py; code_factory.py; code_factory_analysis.py; code_factory_build.py | Working tree at 08862f2 | 19 Oct 2026" vertex="1"><mxGeometry height="25" width="1050" x="35" y="1002" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>