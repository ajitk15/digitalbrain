th="220" x="315" y="140" as="geometry" /></mxCell><mxCell id="scan" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;3. Security scan&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;ClamAV; refuse infected&lt;br&gt;or unverifiable input&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="140" as="geometry" /></mxCell><mxCell id="reject" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Rejected / failed&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Record the reason&lt;br&gt;Never convert unsafe input&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="855" y="140" as="geometry" /></mxCell><mxCell id="convert" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;4. Convert + OCR&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Isolated offline conversion&lt;br&gt;Markdown text + digest&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="290" as="geometry" /></mxCell><mxCell id="record" parent="1" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;5. Knowledge record&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Immutable source revision&lt;br&gt;chunks + source identity&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="290" as="geometry" /></mxCell><mxCell id="checks" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;6. Advisory checks&lt;/b&gt;&lt;br&gt;&l