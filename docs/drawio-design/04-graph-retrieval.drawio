<mxfile host="app.diagrams.net" type="device"><diagram id="04-graph-retrieval" name="Graph retrieval process"><mxGraphModel adaptiveColors="auto" background="#ffffff" pageWidth="1120" pageHeight="1040"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#24344b;" value="04 / Graph retrieval process" vertex="1"><mxGeometry height="42" width="1050" x="35" y="22" as="geometry" /></mxCell><mxCell id="subtitle" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=0;fontColor=#24344b;" value="Rank candidate relationships, then prove every citation from its live source." vertex="1"><mxGeometry height="38" width="1050" x="35" y="70" as="geometry" /></mxCell><mxCell id="question" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Question / caller&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Chat, API, MCP, Code Factory&lt;br&gt;Code review or ServiceOps&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="45" y="140" as="geometry" /></mxCell><mxCell id="access" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Application access&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Grant + feature checks&lt;br&gt;Scope fixed before retrieval&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="140" as="geometry" /></mxCell><mxCell id="version" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Published version&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Latest or conversation-pinned&lt;br&gt;Drafts refused&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="140" as="geometry" /></mxCell><mxCell id="deny" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;No evidence / refusal&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;No grant, no published graph&lt;br&gt;or no valid citations&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="855" y="140" as="geometry" /></mxCell><mxCell id="query" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Read the question&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Follow-up context, terms&lt;br&gt;Keep BR-05-like IDs whole&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="290" as="geometry" /></mxCell><mxCell id="rank" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Rank by words&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Coverage then BM25&lt;br&gt;Rows or JSON snapshot&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="290" as="geometry" /></mxCell><mxCell id="semantic" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Fuse by meaning&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Optional query embedding&lt;br&gt;Owner-enabled paid help&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="45" y="290" as="geometry" /></mxCell><mxCell id="walk" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Walk relationships&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Typed two-hop paths&lt;br&gt;Plus one-hop neighbours&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="45" y="450" as="geometry" /></mxCell><mxCell id="verify" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Verify live evidence&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Allowed + active + same digest&lt;br&gt;Exact quote still present&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="450" as="geometry" /></mxCell><mxCell id="spread" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Diverse evidence&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Spread across sources&lt;br&gt;Keep at most 8 citations&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="450" as="geometry" /></mxCell><mxCell id="rerank" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Optional reranking&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Model reorders IDs only&lt;br&gt;Cannot invent evidence&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="855" y="450" as="geometry" /></mxCell><mxCell id="caller" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Caller decides output&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Evidence API or answer flow&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="585" y="620" as="geometry" /></mxCell><mxCell id="json" parent="1" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;API / MCP evidence&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;JSON citations + graph version&lt;br&gt;No model spend&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="315" y="620" as="geometry" /></mxCell><mxCell id="answer" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Compose answer&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Chat model uses verified pack&lt;br&gt;Scoped tools may find more&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="855" y="620" as="geometry" /></mxCell><mxCell id="final" parent="1" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontColor=#24344b;fontSize=16;spacing=8;" value="&lt;b&gt;Verify again + save&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;Keep only live valid citations&lt;br&gt;Persist and render escaped&lt;/span&gt;" vertex="1"><mxGeometry height="86" width="220" x="855" y="780" as="geometry" /></mxCell><mxCell id="e0" edge="1" parent="1" source="question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#637994;strokeWidth=1.5;fontSize=12;fontColor=#3b4e66;labelBackgroundColor=#ffffff;defaultLabelBackgroundColor=gap;dashed=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="access" value=""><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" source="access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#637994;strokeWidth=1.5;fontSize=12;fontColor=#3b4e66;labelBackgroundColor=#ffffff;defaultLabelBackgroundColor=gap;dashed=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="version" value="allowed"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" edge="1" parent="1" source="version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#3b4e66;labelBackgroundColor=#ffffff;defaultLabelBackgroundColor=gap;dashed=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="deny" value="none / draft"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e3" edge="1" parent="1" source="version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#637994;strokeWidth=1.5;fontSize=12;fontColor=#3b4e66;labelBackgroundColor=#ffffff;defaultLabelBackgroundColor=gap;dashed=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="query" value="published"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e4" edge="1" parent="1" source="query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#637994;strokeWidth=1.5;fontSize=12;fontColor=#3b4e66;labelBackgroundColor=#ffffff;defaultLabelBackgroundColor=gap;dashed=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="rank" value=""><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e5" edge="1" parent="1" source="rank" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#637994;strokeWidth=1.5;fontSize=12;fontColor=#3b4e66;labelBackgroundColor=#ffffff;defaultLabelBackgroundColor=gap;dashed=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;" target="semantic" value=""><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e6" edge="1" parent="1" source="semantic" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#637994;strokeWidth=1.5;fontSize=12;fontColor=#3b4e66;labelBackgroundColor=#ffffff;defaultLabelBackgro