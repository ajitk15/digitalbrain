# Everything the image builds for itself, or must never contain.
#
# .runtime holds uploaded documents and the local SQLite database; staticfiles
# is produced by collectstatic inside the build. Copying either from a
# developer's machine would ship that developer's data and a stale manifest.
.git
.github
.venv
.runtime
staticfiles
**/__pycache__
**/*.pyc
.ruff_cache
.coverage
htmlcov
# Local agent settings and worktrees: other checkouts of this repository, with
# their own .runtime and configuration, which the image must never carry.
.claude

# Never: the only thing .env may hold is SITE_ADMIN_USER_ID, and config/local.toml
# is a development file whose mode is "development".
.env
config/local.toml
config/local.runtime.toml

# Not part of the running platform.
demo-artifacts
design
docs
*.md
!README.md
start-all.cmd
start-all.ps1
stop-all.cmd
stop-all.ps1

# Only the demo corpus and sample application, never presentations or local venvs.
!demo-artifacts/
demo-artifacts/*
!demo-artifacts/docs/
!demo-artifacts/docs/**
!demo-artifacts/carepath/
!demo-artifacts/carepath/**
# Frozen offline scorecard inputs, without local Jira issue ids or tooling.
!demo-artifacts/demo-kit/
demo-artifacts/demo-kit/*
!demo-artifacts/demo-kit/benchmark-questions.json
!demo-artifacts/demo-kit/jira-export.json
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.coverage
**/*.pyc
