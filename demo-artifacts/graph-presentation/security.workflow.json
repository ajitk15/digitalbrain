    {"id": "scope", "lane": "request", "col": 2, "type": "security", "label": "Scoped access", "width": 150},
    {"id": "source", "lane": "data", "col": 2, "type": "database", "label": "Eligible sources", "width": 150},
    {"id": "check", "lane": "evidence", "col": 3, "type": "security", "label": "Recheck evidence", "width": 150},
