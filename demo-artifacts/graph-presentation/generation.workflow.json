    {
      "dot": "cyan",
      "title": "Knowledge graph · application modules",
      "items": [
        "MarkItDown → graphs.py builds document, row and value links.",
        "graph_ai.py + ontology.py validate optional AI relationships."
      ]
    },
    {
      "dot": "emerald",
      "title": "Graphify · two local analysis roles",
      "items": [
        "Code Graph: code_graph_graphify.py uses Tree-sitter extraction.",
        "Knowledge themes: graph_quality.py uses NetworkX + Leiden."
      ]
    },
    {
      "dot": "violet",
      "title": "Graph RAG · retrieval then answer",
      "items": [
        "graph_ai.py: BM25 + optional NumPy vectors + graph walks.",
        "Verify source, quote, digest and access; ai.py generates the answer."
      ]
    },
    {
      "dot": "amber",
      "title": "Platform · storage, UI and security",
      "items": [
        "Django stores graph JSON; SQLite locally / PostgreSQL in production.",
        "Canvas UI; policy.py, permissions.py, sensitivity.py protect access."
      ]
    }
